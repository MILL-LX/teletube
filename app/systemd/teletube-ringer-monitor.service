[Unit]
Description=Teletube ringer monitor (rings the bell on a fixed cadence)
PartOf=teletube.target

[Service]
Type=exec
User=pi
WorkingDirectory=/home/pi/teletube/app/src
Environment=PYTHONPATH=/home/pi/teletube/app/src
ExecStart=/home/pi/.local/bin/uv run python apps/ringer_monitor.py
Restart=on-failure
RestartSec=2
# If shutdown ever blocks, don't wait the default 90s.
TimeoutStopSec=5
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=teletube.target
