[Unit]
Description=Teletube display monitor (draws prompts to the screen)
PartOf=teletube.target
Requires=teletube-broker.service
After=teletube-broker.service

[Service]
Type=exec
User=pi
WorkingDirectory=/home/pi/teletube/app/src
Environment=PYTHONPATH=/home/pi/teletube/app/src
ExecStart=/home/pi/.local/bin/uv run python apps/display_monitor.py
Restart=on-failure
RestartSec=2
# If shutdown ever blocks, don't wait the default 90s.
TimeoutStopSec=5
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=teletube.target
