[Unit]
Description=Teletube video player (plays videos for entered years)
PartOf=teletube.target
Requires=teletube-broker.service
After=teletube-broker.service

[Service]
Type=exec
User=pi
WorkingDirectory=/home/pi/teletube/app/src
Environment=PYTHONPATH=/home/pi/teletube/app/src
ExecStart=/home/pi/.local/bin/uv run python apps/video_player_app.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=teletube.target
